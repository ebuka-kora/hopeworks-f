VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Vercel (production): set VITE_API_URL to your Railway API URL so /c/:id share
# previews can fetch campaign title, summary, and cover for Open Graph tags.
# Example: VITE_API_URL=https://hopeworks-b-hopeworks.up.railway.app
#
# Test share previews locally with: npx vercel dev (from frontend/)
# Then open http://localhost:3000/c/<projectId>

# OAuth (Google / Apple) — required Supabase + provider console setup:
#
# 1) Supabase → Authentication → URL Configuration
#    Site URL: http://localhost:3000
#    Redirect URLs: http://localhost:3000
#
# 2) Supabase → Authentication → Providers → Google (enable + Client ID + Client Secret)
#    Google Cloud → Credentials → OAuth client → Authorized redirect URI:
#    https://<project-ref>.supabase.co/auth/v1/callback
#
# 3) Apple: same pattern — enable in Supabase Providers + Apple Developer Services ID
